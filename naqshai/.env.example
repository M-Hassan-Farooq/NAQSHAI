# ─────────────────────────────────────────────────────────────
# NAQSHAI environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#   PowerShell:  Copy-Item .env.example .env.local
#   bash/zsh:    cp .env.example .env.local
# Placeholder values only — this file is safe to commit.
# ─────────────────────────────────────────────────────────────

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — required for listing approvals, the review
# queue, and embedding backfill. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Operator gating for /review and the approve/reject endpoints.
# Send as: Authorization: Bearer <OPERATOR_PASSPHRASE>
OPERATOR_PASSPHRASE=a-long-random-secret

# Google Maps JavaScript API key (browser) — enable Maps JS API + Places
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key

# Google Gemini API key (server) — powers chat + embeddings
GEMINI_API_KEY=your-gemini-key

# Canonical site URL for auth redirects (prod: https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
